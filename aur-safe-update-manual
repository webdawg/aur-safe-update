#!/usr/bin/env bash
set -Eeuo pipefail

AURWATCH_API="${AURWATCH_API:-https://aurwatch.org/api/v1/check}"
AUR_RPC="${AUR_RPC:-https://aur.archlinux.org/rpc/v5/info}"

# Default: API errors and unknown verdicts block the check; stale scans
# require review. Set AURWATCH_FAIL_OPEN=1 to report API errors and unknown
# verdicts as review-required instead of blocking.
FAIL_OPEN="${AURWATCH_FAIL_OPEN:-0}"

if (($#)); then
    echo "Usage: aur-safe-update-manual" >&2
    exit 64
fi

case "$FAIL_OPEN" in
    0 | 1) ;;
    *)
        echo "AURWATCH_FAIL_OPEN must be either 0 or 1." >&2
        exit 64
        ;;
esac

if [[ "$AURWATCH_API" != https://* || "$AUR_RPC" != https://* ]]; then
    echo "AURWATCH_API and AUR_RPC must use HTTPS." >&2
    exit 64
fi

for cmd in curl jq pacman date vercmp; do
    command -v "$cmd" >/dev/null || {
        echo "Missing dependency: $cmd" >&2
        exit 127
    }
done

# Determine pending AUR upgrades directly from pacman and the public AUR RPC.
# This deliberately does not require or invoke paru or yay.
if ! foreign_output="$(pacman -Qmq)"; then
    echo "Could not enumerate installed foreign packages; refusing to continue." >&2
    exit 2
fi

updates=()
while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue

    if ! installed_output="$(pacman -Q "$pkg")"; then
        echo "Could not query installed version for $pkg; refusing to continue." >&2
        exit 2
    fi
    installed_version="${installed_output##* }"

    if ! aur_info="$(
        curl --disable --proto '=https' -fsS \
            --connect-timeout 5 \
            --max-time 15 \
            --retry 1 \
            -G \
            --data-urlencode "arg[]=$pkg" \
            "$AUR_RPC"
    )"; then
        echo "Could not query current AUR metadata for $pkg; refusing to continue." >&2
        exit 2
    fi

    if ! aur_version="$(jq -er --arg pkg "$pkg" '
        .results[]?
        | select(.Name == $pkg)
        | .Version
    ' <<< "$aur_info" 2>/dev/null)"; then
        # Foreign packages not present in the AUR may be local or VCS packages.
        # They cannot be identified as AUR upgrades by this command.
        continue
    fi

    if (( $(vercmp "$aur_version" "$installed_version") > 0 )); then
        updates+=("$pkg")
    fi
done <<< "$foreign_output"

if ((${#updates[@]} == 0)); then
    echo "AURWatch: no AUR upgrades found."
    exit 0
fi

echo "AURWatch: checking ${#updates[@]} AUR update(s)..."

blocked=0
review=0

mark_review_required() {
    if ((FAIL_OPEN)); then
        review=1
    else
        blocked=1
    fi
}

for pkg in "${updates[@]}"; do
    page="https://aurwatch.org/package/$pkg"

    if ! verdict="$(
        curl --disable --proto '=https' -fsS \
            --connect-timeout 5 \
            --max-time 15 \
            --retry 1 \
            -G \
            --data-urlencode "pkg=$pkg" \
            "$AURWATCH_API"
    )"; then
        echo "[API ERROR] $pkg: request failed"
        echo "            $page"
        mark_review_required
        continue
    fi

    if ! jq -e --arg pkg "$pkg" \
        'type == "object" and .pkg == $pkg' \
        >/dev/null <<< "$verdict"; then
        echo "[API ERROR] $pkg: invalid or mismatched response"
        echo "            $page"
        mark_review_required
        continue
    fi

    status="$(
        jq -r '
            if (.status | type) == "string"
            then (.status | ascii_downcase)
            else "unknown"
            end
        ' <<< "$verdict"
    )"

    scanned="$(
        jq -r '
            if (.last_scanned | type) == "string"
            then .last_scanned
            else empty
            end
        ' <<< "$verdict"
    )"

    rules="$(
        jq -r '
            (.rules // [])
            | if type == "array" then . else [] end
            | [
                .[]
                | if type == "string" then .
                  elif type == "object" then (
                      .description //
                      .name //
                      .rule //
                      .id //
                      tostring
                  )
                  else tostring
                  end
                | tostring
            ]
            | join("; ")
        ' <<< "$verdict"
    )"

    # A high verdict always blocks, even when its freshness cannot be
    # confirmed and fail-open review mode is enabled.
    if [[ "$status" == "high" ]]; then
        echo "[HIGH]    $pkg${rules:+: $rules}"
        echo "          $page"
        blocked=1
        continue
    fi

    # Confirm that AURWatch scanned the current AUR recipe rather than an
    # earlier revision. Missing or malformed metadata is never treated as fresh.
    stale=1
    stale_reason=""

    if [[ -z "$scanned" ]]; then
        stale_reason="scan timestamp is missing"
    elif ! scanned_epoch="$(date -d "$scanned" +%s 2>/dev/null)"; then
        stale_reason="scan timestamp is invalid"
    elif ! aur_info="$(
        curl --disable --proto '=https' -fsS \
            --connect-timeout 5 \
            --max-time 15 \
            --retry 1 \
            -G \
            --data-urlencode "arg[]=$pkg" \
            "$AUR_RPC"
    )"; then
        stale_reason="current AUR metadata could not be retrieved"
    elif ! aur_modified="$(
        jq -er --arg pkg "$pkg" '
            .results[]?
            | select(.Name == $pkg)
            | .LastModified
        ' <<< "$aur_info"
    )" || [[ ! "$aur_modified" =~ ^[0-9]+$ ]]; then
        stale_reason="current AUR metadata is missing or invalid"
    elif ((scanned_epoch < aur_modified)); then
        stale_reason="current AUR recipe is newer than its scan"
    else
        stale=0
    fi

    if ((stale)); then
        echo "[STALE]   $pkg: $stale_reason"
        echo "          $page"
        # A stale scan is a freshness warning, not a danger signal: the verdict
        # may not cover the current recipe, but the user can choose to proceed
        # after review. Verification failures (API errors, unknown verdicts)
        # remain fail-closed unless AURWATCH_FAIL_OPEN=1; high stays blocked.
        review=1
        continue
    fi

    case "$status" in
        clean)
            echo "[CLEAN]   $pkg"
            ;;

        low)
            echo "[LOW]     $pkg${rules:+: $rules}"
            echo "          $page"
            ;;

        medium)
            echo "[MEDIUM]  $pkg${rules:+: $rules}"
            echo "          $page"
            review=1
            ;;


        *)
            echo "[UNKNOWN] $pkg: unrecognized AURWatch verdict"
            echo "          $page"
            mark_review_required
            ;;
    esac
done

if ((blocked)); then
    echo
    echo "Manual check blocked. Review the package(s) above." >&2
    exit 3
fi

if ((review)); then
    echo "Manual review required; no update was performed." >&2
    exit 4
fi

echo "AURWatch: manual check complete; no blocking findings."
